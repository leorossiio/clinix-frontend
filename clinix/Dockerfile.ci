# Ambiente de CI do frontend: Node + Chromium para os testes headless do Karma.
# Usado pelo Jenkinsfile (agent dockerfile) e reproduzível localmente:
#   docker build -f Dockerfile.ci -t clinix-frontend-ci .
#   docker run --rm -v "$PWD:/app" -w /app clinix-frontend-ci sh -c "npm ci && npm run test:ci"
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends chromium git \
  && rm -rf /var/lib/apt/lists/*

ENV CHROME_BIN=/usr/bin/chromium \
    NG_CLI_ANALYTICS=false
